<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido de la hoja inferior (bottom sheet) de la Sección 5. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/espacio_interno">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_chico"
        android:text="@string/s5_hoja_encabezado"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <TextView
        android:id="@+id/opcion_compartir"
        style="@style/CatalogoUI.OpcionHoja"
        android:text="@string/s5_opcion_compartir"
        app:drawableStartCompat="@drawable/ic_share" />

    <TextView
        android:id="@+id/opcion_copiar"
        style="@style/CatalogoUI.OpcionHoja"
        android:text="@string/s5_opcion_copiar"
        app:drawableStartCompat="@drawable/ic_copy" />

    <TextView
        android:id="@+id/opcion_editar"
        style="@style/CatalogoUI.OpcionHoja"
        android:text="@string/s5_opcion_editar"
        app:drawableStartCompat="@drawable/ic_edit" />
</LinearLayout>
